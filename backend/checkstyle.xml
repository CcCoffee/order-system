<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Order System - Backend Checkstyle configuration.

  This is the single source of truth for the mechanical Java style rules that
  apply to the backend modules. It is intentionally focused and conservative:
  rules that can be judged objectively are enforced, while subjective rules
  that would frequently conflict with the existing codebase are left out.

  Responsibilities:
    - Java source-level mechanical checks (naming, imports, braces, whitespace,
      file/line size limits).

  Non-responsibilities (handled elsewhere):
    - Architecture layering      -> scripts/verify-architecture.sh + ArchUnit
    - Business rules / state     -> JUnit + integration tests
    - API / DB / infra behavior  -> scripts/verify-api.sh, verify-infrastructure.sh
    - Repository-wide file size  -> a dedicated verify script (not Checkstyle)
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- File size limit for an individual Java source file. -->
    <module name="FileLength">
        <property name="max" value="500"/>
    </module>

    <!-- Maximum line length. Package/import statements and URLs are ignored. -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://|ftp://"/>
    </module>

    <!-- Tabs are not allowed for indentation. -->
    <module name="FileTabCharacter"/>

    <module name="TreeWalker">
        <!-- ===== Naming ===== -->
        <module name="PackageName"/>
        <module name="TypeName"/>
        <module name="ClassTypeParameterName"/>
        <module name="MethodName"/>
        <module name="MethodTypeParameterName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ConstantName"/>

        <!-- ===== Imports ===== -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- ===== Basic structure ===== -->
        <module name="OneTopLevelClass"/>
        <module name="FinalClass"/>
        <module name="NeedBraces"/>
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="EmptyBlock"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="InnerTypeLast"/>
        <module name="VisibilityModifier"/>
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
        </module>

        <!-- ===== Whitespace ===== -->
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround"/>
        <module name="NoWhitespaceBefore"/>
        <module name="GenericWhitespace"/>
        <module name="ParenPad"/>
        <module name="MethodParamPad"/>
    </module>
</module>
